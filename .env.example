# AP Payment Fraud Sentinel — environment template.
# Copy to .env (or let setup.sh / setup.bat create it) and adjust as needed.

# SQLite database. Relative `file:` paths resolve from prisma/schema.prisma,
# so file:../db/custom.db points at <project>/db/custom.db.
DATABASE_URL=file:../db/custom.db

# RocketRide cloud pipeline. Leave ROCKETRIDE_API_KEY empty to run the
# pipeline 100% locally (deterministic local executor — no cloud calls).
ROCKETRIDE_APIKEY=
# Legacy alias also accepted by the worker:
# ROCKETRIDE_API_KEY=
ROCKETRIDE_WEBHOOK_SECRET=
ROCKETRIDE_URI=https://api.rocketride.ai
# Legacy alias also accepted by the worker:
# ROCKETRIDE_SERVICE_URL=https://api.rocketride.ai

# Service ports (defaults match the shipped scripts).
WORKER_PORT=3030
WS_PORT=3003

# Optional overrides (rarely needed):
# WORKER_URL=http://localhost:3030     # Next.js server -> worker
# WS_URL=http://localhost:3003         # Next.js server -> WS health ping
# APFRAUD_DATA_DIR=/absolute/path/to/data
# APFRAUD_DB_PATH=/absolute/path/to/custom.db
