{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "name": "Controller Gate Input",
      "description": "Ingests controller decision review query.",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      },
      "ui": {
        "position": { "x": 40, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "name": "Gate Evaluator LLM",
      "description": "Evaluates release vs hold decision policy and compliance rules.",
      "input": [
        {
          "from": "chat_1",
          "lane": "questions"
        }
      ],
      "config": {
        "profile": "openai-4o",
        "openai-4o": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        },
        "parameters": {}
      },
      "ui": {
        "position": { "x": 260, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Decision",
      "description": "Returns final decision gate action (release vs hold).",
      "input": [
        {
          "from": "llm_openai_1",
          "lane": "answers"
        }
      ],
      "config": {
        "laneName": "answers",
        "parameters": {}
      },
      "ui": {
        "position": { "x": 480, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
  "name": "Stage 07 — Controller Decision Gate Pipeline",
  "description": "Evaluates controller review decisions via LLM gate policy and returns release or hold decision action.",
  "version": 1,
  "source": "chat_1",
  "project_id": "307c0949-be56-494d-9b5e-d66de957dded",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  }
}
