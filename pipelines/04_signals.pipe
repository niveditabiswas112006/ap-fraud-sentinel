{
  "components": [
    {
      "id": "webhook_signals",
      "provider": "webhook",
      "name": "Invoice Signals Payload",
      "description": "Receives extracted case facts and email metadata.",
      "config": {
        "path": "/signals",
        "methods": [
          "POST"
        ],
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": {
          "x": 40,
          "y": 350
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "amount_anomaly",
      "provider": "anomaly_detector",
      "name": "Amount Anomaly Detector",
      "description": "Calculates z-score anomaly of current invoice amount.",
      "config": {
        "metric": "z_score",
        "field": "amount_usd",
        "baseline": "{{ case.stats.amount_mean }}",
        "std": "{{ case.stats.amount_std }}",
        "threshold": 3,
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 270,
          "y": 60
        },
        "nodeType": "default",
        "formDataValid": false
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_signals"
        }
      ]
    },
    {
      "id": "domain_check",
      "provider": "python_tool",
      "name": "Domain Lookalike Checker",
      "description": "Compares email sender domain against vendor registered domain.",
      "config": {
        "function": "worker.utils.domain_check.compare_domains",
        "inputs": {
          "sender_domain": "{{ email.from_domain }}",
          "registered_domain": "{{ vendor.registeredDomain }}"
        },
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 270,
          "y": 170
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_signals"
        }
      ]
    },
    {
      "id": "timing_check",
      "provider": "python_tool",
      "name": "Rapid Bank Change Timing Evaluator",
      "description": "Checks if bank change request date is suspiciously close to invoice due date.",
      "config": {
        "function": "worker.utils.timing.bank_change_vs_due_date",
        "inputs": {
          "bank_change_date": "{{ email.bank_change_request_date }}",
          "due_date": "{{ facts.due_date }}"
        },
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 270,
          "y": 280
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_signals"
        }
      ]
    },
    {
      "id": "duplicate_check",
      "provider": "rocketride_sql",
      "name": "Duplicate Invoice Search",
      "description": "Queries payment history for duplicate invoice numbers.",
      "config": {
        "query": "SELECT COUNT(*) AS dupes FROM PaymentHistory WHERE invoiceNumber = :inv_no",
        "params": {
          "inv_no": "{{ facts.invoice_number }}"
        },
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 270,
          "y": 390
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_signals"
        }
      ]
    },
    {
      "id": "first_time_vendor",
      "provider": "python_tool",
      "name": "First Time Vendor Evaluator",
      "description": "Checks whether vendor ID is missing from Vendor Master database.",
      "config": {
        "function": "worker.utils.stats.is_first_time",
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 270,
          "y": 500
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_signals"
        }
      ]
    },
    {
      "id": "threshold_skirting",
      "provider": "python_tool",
      "name": "SAR Threshold Skirting Detector",
      "description": "Detects invoice amounts structured just below $10,000 threshold.",
      "config": {
        "function": "worker.signals.check_threshold_skirting",
        "inputs": {
          "amount": "{{ facts.amount_usd }}"
        },
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 270,
          "y": 610
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_signals"
        }
      ]
    },
    {
      "id": "guardrails",
      "provider": "guardrails",
      "name": "Signal Guardrails Validator",
      "description": "Validates signal payload structures against signal_schema_v1.",
      "config": {
        "validate": "signal_schema_v1",
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 510,
          "y": 350
        },
        "nodeType": "default",
        "formDataValid": false
      },
      "input": [
        {
          "lane": "documents",
          "from": "amount_anomaly"
        },
        {
          "lane": "documents",
          "from": "domain_check"
        },
        {
          "lane": "documents",
          "from": "timing_check"
        },
        {
          "lane": "documents",
          "from": "duplicate_check"
        },
        {
          "lane": "documents",
          "from": "first_time_vendor"
        },
        {
          "lane": "documents",
          "from": "threshold_skirting"
        }
      ]
    },
    {
      "id": "assemble",
      "provider": "python_tool",
      "name": "Composite Risk Score Assembler",
      "description": "Calculates weighted composite risk score and generates recommendation.",
      "config": {
        "function": "worker.signals.assemble_signals",
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 730,
          "y": 350
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "answers",
          "from": "guardrails"
        }
      ]
    },
    {
      "id": "response_signals_1",
      "provider": "response_answers",
      "name": "Return Signals",
      "description": "Outputs composite risk score and recommendation to client.",
      "config": {
        "laneName": "answers",
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 950,
          "y": 350
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "answers",
          "from": "assemble"
        },
        {
          "lane": "answers",
          "from": "guardrails"
        }
      ]
    }
  ],
  "name": "Stage 04 — Risk Signals & Composite Scoring Pipeline",
  "description": "Processes payload text, chunks into documents, embeds vectors, evaluates 6 risk detection rules using LLM reasoning, and outputs composite risk score.",
  "version": 1,
  "source": "webhook_1",
  "project_id": "ed46e32a-f8d8-47a1-8c54-f068c8404ff8",
  "isLocked": false,
  "snapToGrid": true,
  "snapGridSize": [
    10,
    10
  ],
  "docRevision": 1
}