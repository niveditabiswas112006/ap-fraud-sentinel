{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "name": "Vendor Call Audio Input",
      "description": "Receives vendor call audio recording via HTTP POST.",
      "config": {
        "path": "/verification-call",
        "methods": ["POST"],
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": { "x": 40, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "audio_transcribe_1",
      "provider": "audio_transcribe",
      "name": "Speech-to-Text Transcriber",
      "description": "Transcribes call audio recording to text.",
      "input": [
        {
          "from": "webhook_1",
          "lane": "audio"
        }
      ],
      "config": {
        "model": "whisper-1",
        "parameters": {}
      },
      "ui": {
        "position": { "x": 260, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "extract_data_1",
      "provider": "extract_data",
      "name": "Transcript Intent Classifier",
      "description": "Classifies transcript text to determine if vendor approved or denied the bank change request.",
      "input": [
        {
          "from": "audio_transcribe_1",
          "lane": "text"
        }
      ],
      "config": {
        "schema": "call_analysis_v1",
        "parameters": {}
      },
      "ui": {
        "position": { "x": 480, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "name": "LLM Classifier Engine",
      "description": "LLM model powering transcript analysis.",
      "control": [
        {
          "classType": "llm",
          "from": "extract_data_1"
        }
      ],
      "config": {
        "profile": "openai-4o",
        "openai-4o": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        },
        "parameters": {}
      },
      "ui": {
        "position": { "x": 480, "y": 360 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Verification",
      "description": "Returns verification classification (approved/denied) to client.",
      "input": [
        {
          "from": "extract_data_1",
          "lane": "answers"
        }
      ],
      "config": {
        "laneName": "answers",
        "parameters": {}
      },
      "ui": {
        "position": { "x": 700, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
  "name": "Stage 06 — Automated Verification Call Pipeline",
  "description": "Ingests vendor call audio, transcribes speech, classifies verification intent via LLM, and returns verification result.",
  "version": 1,
  "source": "webhook_1",
  "project_id": "ffbce23e-386c-4988-93a1-0e3bb701d2f7",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  }
}