{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "name": "Vendor Grounding Query",
      "description": "Ingests vendor lookup question.",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      },
      "ui": {
        "position": { "x": 40, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "embedding_1",
      "provider": "embedding_transformer",
      "name": "Question Embedder",
      "description": "Embeds vendor lookup question into vector space.",
      "input": [
        {
          "from": "chat_1",
          "lane": "questions"
        }
      ],
      "config": {
        "profile": "miniLM",
        "parameters": {}
      },
      "ui": {
        "position": { "x": 260, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "qdrant_1",
      "provider": "qdrant",
      "name": "Vendor Master Store",
      "description": "Searches vector store for matching vendor master and payment history records.",
      "input": [
        {
          "from": "embedding_1",
          "lane": "questions"
        }
      ],
      "config": {
        "profile": "local",
        "local": {
          "host": "localhost",
          "port": 6333,
          "collection": "vendors"
        },
        "parameters": {}
      },
      "ui": {
        "position": { "x": 480, "y": 200 },
        "measured": { "width": 160, "height": 135 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "prompt_1",
      "provider": "prompt",
      "name": "Context Merging Prompt",
      "description": "Merges retrieved vendor master history context with question instructions.",
      "input": [
        {
          "from": "qdrant_1",
          "lane": "documents"
        },
        {
          "from": "qdrant_1",
          "lane": "questions"
        }
      ],
      "config": {
        "instructions": [
          "Verify extracted invoice details against grounded vendor master records and payment history."
        ],
        "parameters": {}
      },
      "ui": {
        "position": { "x": 700, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "name": "Grounded LLM Evaluator",
      "description": "Generates grounded vendor risk assessment.",
      "input": [
        {
          "from": "prompt_1",
          "lane": "questions"
        }
      ],
      "config": {
        "profile": "openai-4o",
        "openai-4o": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        },
        "parameters": {}
      },
      "ui": {
        "position": { "x": 920, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Answers",
      "description": "Returns grounded vendor facts to client.",
      "input": [
        {
          "from": "llm_openai_1",
          "lane": "answers"
        }
      ],
      "config": {
        "laneName": "answers",
        "parameters": {}
      },
      "ui": {
        "position": { "x": 1140, "y": 200 },
        "measured": { "width": 160, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
  "name": "Stage 03 — Vendor Master Grounding Pipeline",
  "description": "Performs RAG vector search against Vendor Master DB, merges historical context, and outputs grounded vendor risk analysis.",
  "version": 1,
  "source": "chat_1",
